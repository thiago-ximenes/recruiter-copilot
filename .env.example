GEMINI_API_KEY=

# Telegram (notify_thiago) — sem isto, a notificação de lead é no-op
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Admin (auth do /admin)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Observabilidade (OTel) — opcional
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
