DATABASE_URL=postgres://recruiter:recruiter@localhost:5433/recruiter_copilot

# LLM
LLM_PROVIDER=deepseek      # deepseek
DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=

# Embeddings (RAG vetorial pgvector) — sem isto, o agente usa a KB completa
